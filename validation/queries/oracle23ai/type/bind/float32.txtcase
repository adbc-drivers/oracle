sort-keys = [["RES", "ascending"]]

[setup]
drop = "TEST_FLOAT32"

[tags]
sql-type-name = "BINARY_FLOAT"

// part: setup_query

CREATE TABLE test_float32 (
    res BINARY_FLOAT
);

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES",
            "format": "f",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"RES": null}
{"RES": -3.4028235e+38}
{"RES": -2.5}
{"RES": 0.0}
{"RES": 3.14159}
{"RES": 3.4028235e+38}
