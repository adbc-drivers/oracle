// part: metadata

[setup.statement.options]
"oracle.query.unbounded_number_type" = { apply = "int64", revert = "float64" }

[tags]
field-type-name = "NUMBER"
sql-type-name = "NUMBER (oracle.query.unbounded_number_type = int64)"

// part: query

SELECT COUNT(*) AS RES FROM DUAL

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES",
            "format": "l",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"RES": 1}
