[tags]
sql-type-name = "NUMBER(p, s), NUMBER(p), NUMBER(*, s)"

// part: query

SELECT CAST(123.45 AS NUMERIC(10,2)) AS RES FROM DUAL

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES",
            "format": "d:10,2",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"RES": "123.45"}
