[setup]
drop = "TEST_DECIMAL"

[tags]
sql-type-name = "NUMBER(p, s), NUMBER(p), NUMBER(*, s)"

// part: query

SELECT RES FROM TEST_DECIMAL ORDER BY IDX

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES",
            "format": "d:10,2",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"RES": "123.45"}
{"RES": "0"}
{"RES": "-999.99"}
{"RES": "9999999.99"}
{"RES": null}
