// part: metadata

# Copyright (c) 2025 Columnar Technologies Inc.  All rights reserved.

ignore-lints = ["must-test-null-values"]

[setup]
drop = "TEST_CHAR"

[tags]
sql-type-name = "CHAR"
caveats = ["Oracle treats empty strings as NULL; rust-oracledb preserves NULL on read (the legacy driver normalizes it to an empty string)"]

// part: setup_query

CREATE TABLE test_char (
    idx INTEGER,
    res CHAR(1),
    res2 CHAR(10)
);

INSERT INTO test_char (idx, res, res2) VALUES (1, 'a', 'asdf');
INSERT INTO test_char (idx, res, res2) VALUES (2, ' ', 'foobar');
INSERT INTO test_char (idx, res, res2) VALUES (3, NULL, NULL);

// part: query

SELECT RES, RES2 FROM TEST_CHAR ORDER BY IDX ASC

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES",
            "format": "u",
            "flags": ["nullable"]
        },
        {
            "name": "RES2",
            "format": "u",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"RES": "a", "RES2": "asdf      "}
{"RES": " ", "RES2": "foobar    "}
{"RES": null, "RES2": null}
