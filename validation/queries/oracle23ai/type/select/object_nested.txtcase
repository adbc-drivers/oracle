// part: metadata


[setup]
drop = "TEST_OBJECT_NESTED"

[setup.connection.options]
"oracle.use_extension_type" = { apply = "true", revert = "false" }

[setup.statement.options]
"oracle.use_extension_type" = { apply = "true", revert = "false" }

[tags]
caveats = ["The driver will return just the storage type by default; the extension type requires oracle.use_extension_type=true"]
sql-type-name = "OBJECT"

// part: setup_query

CREATE TYPE PERSONT3 AS OBJECT (
    IDNO VARCHAR2(100),
    NAME VARCHAR2(100)
);

CREATE TYPE PEOPLET3 AS OBJECT (
    PERSON1 PERSONT3,
    PERSON2 PERSONT3
);

CREATE TABLE test_object_nested (
    idx NUMBER(10, 0),
    res PEOPLET3
);

INSERT INTO test_object_nested (idx, res) VALUES (1, PEOPLET3(PERSONT3('12345', 'John Doe'), PERSONT3('67890', 'Alice Smith')));
INSERT INTO test_object_nested (idx, res) VALUES (2, PEOPLET3(NULL, PERSONT3('67890', 'Alice Smith')));
INSERT INTO test_object_nested (idx, res) VALUES (3, PEOPLET3(PERSONT3('12345', 'John Doe'), NULL));
INSERT INTO test_object_nested (idx, res) VALUES (4, PEOPLET3(NULL, NULL));
INSERT INTO test_object_nested (idx, res) VALUES (5, NULL);

// part: query

SELECT RES FROM TEST_OBJECT_NESTED ORDER BY IDX ASC

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES",
            "format": "u",
            "flags": ["nullable"],
            "metadata": {
                "ARROW:extension:name": "arrow.json"
            }
        }
    ]
}

// part: expected

{"RES": "{\"PERSON1\":{\"IDNO\":\"12345\",\"NAME\":\"John Doe\"},\"PERSON2\":{\"IDNO\":\"67890\",\"NAME\":\"Alice Smith\"}}"}
{"RES": "{\"PERSON1\":null,\"PERSON2\":{\"IDNO\":\"67890\",\"NAME\":\"Alice Smith\"}}"}
{"RES": "{\"PERSON1\":{\"IDNO\":\"12345\",\"NAME\":\"John Doe\"},\"PERSON2\":null}"}
{"RES": "{\"PERSON1\":null,\"PERSON2\":null}"}
{"RES": null}
