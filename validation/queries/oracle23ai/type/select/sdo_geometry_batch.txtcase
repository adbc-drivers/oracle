// part: metadata

[setup]
drop = "TEST_SDO_GEOMETRY"

[setup.connection.options]
"oracle.use_extension_type" = { apply = "true", revert = "false" }

[setup.statement.options]
"oracle.statement.execution_mode" = { apply = "batch", revert = "row" }
"oracle.use_extension_type" = { apply = "true", revert = "false" }

[tags]
sql-type-name = "SDO_GEOMETRY"

// part: setup_query

CREATE TABLE TEST_SDO_GEOMETRY (
    IDX INTEGER,
    RES1 SDO_GEOMETRY,
    RES2 SDO_GEOMETRY,
    RES3 SDO_GEOMETRY
);

INSERT INTO TEST_SDO_GEOMETRY (IDX, RES1, RES2, RES3) VALUES (1, NULL, NULL, NULL);
INSERT INTO TEST_SDO_GEOMETRY (IDX, RES1, RES2, RES3) VALUES (
  2,
  SDO_GEOMETRY('GEOMETRYCOLLECTION EMPTY', 4326),
  SDO_GEOMETRY('GEOMETRYCOLLECTION EMPTY', SDO_WEBMERCATOR),
  SDO_GEOMETRY('GEOMETRYCOLLECTION EMPTY')
);
INSERT INTO TEST_SDO_GEOMETRY (IDX, RES1, RES2, RES3) VALUES (
  3,
  SDO_GEOMETRY('POINT(1 2)', 4326),
  SDO_GEOMETRY('POINT(1 2)', SDO_WEBMERCATOR),
  SDO_GEOMETRY('POINT(1 2)')
);
INSERT INTO TEST_SDO_GEOMETRY (IDX, RES1, RES2, RES3) VALUES (
  4,
  SDO_GEOMETRY('LINESTRING(1 2, 3 4)', 4326),
  SDO_GEOMETRY('LINESTRING(1 2, 3 4)', SDO_WEBMERCATOR),
  SDO_GEOMETRY('LINESTRING(1 2, 3 4)')
);
INSERT INTO TEST_SDO_GEOMETRY (IDX, RES1, RES2, RES3) VALUES (
  5,
  SDO_GEOMETRY('POLYGON((1 2, 3 4, 5 6, 1 2))', 4326),
  SDO_GEOMETRY('POLYGON((1 2, 3 4, 5 6, 1 2))', SDO_WEBMERCATOR),
  SDO_GEOMETRY('POLYGON((1 2, 3 4, 5 6, 1 2))')
);
INSERT INTO TEST_SDO_GEOMETRY (IDX, RES1, RES2, RES3) VALUES (
  6,
  SDO_GEOMETRY('MULTIPOINT(1 2, 3 4)', 4326),
  SDO_GEOMETRY('MULTIPOINT(1 2, 3 4)', SDO_WEBMERCATOR),
  SDO_GEOMETRY('MULTIPOINT(1 2, 3 4)')
);
INSERT INTO TEST_SDO_GEOMETRY (IDX, RES1, RES2, RES3) VALUES (
  7,
  SDO_GEOMETRY('MULTILINESTRING((1 2, 3 4), (5 6, 7 8))', 4326),
  SDO_GEOMETRY('MULTILINESTRING((1 2, 3 4), (5 6, 7 8))', SDO_WEBMERCATOR),
  SDO_GEOMETRY('MULTILINESTRING((1 2, 3 4), (5 6, 7 8))')
);
INSERT INTO TEST_SDO_GEOMETRY (IDX, RES1, RES2, RES3) VALUES (
  8,
  SDO_GEOMETRY('MULTIPOLYGON(((1 2, 3 4, 5 6, 1 2)), ((7 8, 9 10, 11 12, 7 8)))', 4326),
  SDO_GEOMETRY('MULTIPOLYGON(((1 2, 3 4, 5 6, 1 2)), ((7 8, 9 10, 11 12, 7 8)))', SDO_WEBMERCATOR),
  SDO_GEOMETRY('MULTIPOLYGON(((1 2, 3 4, 5 6, 1 2)), ((7 8, 9 10, 11 12, 7 8)))')
);
INSERT INTO TEST_SDO_GEOMETRY (IDX, RES1, RES2, RES3) VALUES (
  9,
  SDO_GEOMETRY('GEOMETRYCOLLECTION(POINT(1 2), LINESTRING(3 4, 5 6))', 4326),
  SDO_GEOMETRY('GEOMETRYCOLLECTION(POINT(1 2), LINESTRING(3 4, 5 6))', SDO_WEBMERCATOR),
  SDO_GEOMETRY('GEOMETRYCOLLECTION(POINT(1 2), LINESTRING(3 4, 5 6))')
);

// part: query

SELECT RES1, RES2, RES3 FROM TEST_SDO_GEOMETRY ORDER BY IDX ASC

