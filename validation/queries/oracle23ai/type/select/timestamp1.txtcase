INSERT INTO test_timestamp1 (idx, "res") VALUES (4, TIMESTAMP '0001-01-01 00:00:00.0');
INSERT INTO test_timestamp1 (idx, "res") VALUES (5, TIMESTAMP '9999-12-31 23:59:59.9');
