// part: metadata

[setup]
drop = "TEST_TIMESTAMP5"

// part: setup_query

CREATE TABLE test_timestamp5 (
    idx INTEGER,
    "res" TIMESTAMP(5)
);

INSERT INTO test_timestamp5 (idx, "res") VALUES (1, TIMESTAMP '2023-05-15 13:45:30.12345');
INSERT INTO test_timestamp5 (idx, "res") VALUES (2, TIMESTAMP '2000-01-01 00:00:00.23456');
INSERT INTO test_timestamp5 (idx, "res") VALUES (3, TIMESTAMP '1969-07-20 20:17:40.34567');
INSERT INTO test_timestamp5 (idx, "res") VALUES (4, TIMESTAMP '0001-01-01 00:00:00.00000');
INSERT INTO test_timestamp5 (idx, "res") VALUES (5, TIMESTAMP '9999-12-31 23:59:59.99999');
INSERT INTO test_timestamp5 (idx, "res") VALUES (6, NULL);

// part: query

SELECT "res" FROM TEST_TIMESTAMP5 ORDER BY IDX
