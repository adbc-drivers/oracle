// part: metadata

[setup]
drop = "TEST_INTERVAL_YEAR_TO_MONTH"

[setup.connection.options]
"oracle.query.year_month_interval_type" = { apply = "monthdaynano", revert = "auto" }

[setup.statement.options]
"oracle.query.year_month_interval_type" = { apply = "monthdaynano", revert = "auto" }

[tags]
caveats = ["The full range of `INTERVAL YEAR(9) TO MONTH` is not representable in Arrow's interval types, which use a 32-bit integer for months. Use `oracle.query.year_month_interval_type = \"string\"` (see below) to handle this case."]
field-type-name = "INTERVAL YEAR TO MONTH"
sql-type-name = "INTERVAL YEAR TO MONTH (oracle.query.year_month_interval_type = monthdaynano)"

// part: setup_query

CREATE TABLE test_interval_year_to_month (
    idx INTEGER,
    res0 INTERVAL YEAR(0) TO MONTH,
    res1 INTERVAL YEAR(1) TO MONTH,
    res2 INTERVAL YEAR(2) TO MONTH,
    res3 INTERVAL YEAR(3) TO MONTH,
    res4 INTERVAL YEAR(4) TO MONTH,
    res5 INTERVAL YEAR(5) TO MONTH,
    res6 INTERVAL YEAR(6) TO MONTH,
    res7 INTERVAL YEAR(7) TO MONTH,
    res8 INTERVAL YEAR(8) TO MONTH,
    res9 INTERVAL YEAR(9) TO MONTH
);

INSERT INTO test_interval_year_to_month VALUES (1, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
INSERT INTO test_interval_year_to_month VALUES (
  2,
  INTERVAL '0-1' YEAR(0) TO MONTH,
  INTERVAL '0-1' YEAR(1) TO MONTH,
  INTERVAL '0-1' YEAR(2) TO MONTH,
  INTERVAL '0-1' YEAR(3) TO MONTH,
  INTERVAL '0-1' YEAR(4) TO MONTH,
  INTERVAL '0-1' YEAR(5) TO MONTH,
  INTERVAL '0-1' YEAR(6) TO MONTH,
  INTERVAL '0-1' YEAR(7) TO MONTH,
  INTERVAL '0-1' YEAR(8) TO MONTH,
  INTERVAL '0-1' YEAR(9) TO MONTH
);
INSERT INTO test_interval_year_to_month VALUES (
  3,
  INTERVAL '0-11' YEAR(0) TO MONTH,
  INTERVAL '9-11' YEAR(1) TO MONTH,
  INTERVAL '99-11' YEAR(2) TO MONTH,
  INTERVAL '999-11' YEAR(3) TO MONTH,
  INTERVAL '9999-11' YEAR(4) TO MONTH,
  INTERVAL '99999-11' YEAR(5) TO MONTH,
  INTERVAL '999999-11' YEAR(6) TO MONTH,
  INTERVAL '9999999-11' YEAR(7) TO MONTH,
  INTERVAL '99999999-11' YEAR(8) TO MONTH,
  INTERVAL '178956970-7' YEAR(9) TO MONTH
);
INSERT INTO test_interval_year_to_month VALUES (
  4,
  INTERVAL '-0-11' YEAR(0) TO MONTH,
  INTERVAL '-9-11' YEAR(1) TO MONTH,
  INTERVAL '-99-11' YEAR(2) TO MONTH,
  INTERVAL '-999-11' YEAR(3) TO MONTH,
  INTERVAL '-9999-11' YEAR(4) TO MONTH,
  INTERVAL '-99999-11' YEAR(5) TO MONTH,
  INTERVAL '-999999-11' YEAR(6) TO MONTH,
  INTERVAL '-9999999-11' YEAR(7) TO MONTH,
  INTERVAL '-99999999-11' YEAR(8) TO MONTH,
  INTERVAL '-178956970-8' YEAR(9) TO MONTH
);


// part: query

SELECT RES0, RES1, RES2, RES3, RES4, RES5, RES6, RES7, RES8, RES9 FROM TEST_INTERVAL_YEAR_TO_MONTH ORDER BY IDX ASC

