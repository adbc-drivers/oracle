// part: metadata

[setup]
drop = "TEST_INTERVAL_DAY_TO_SECOND"

[setup.connection.options]
"oracle.query.day_time_interval_type" = { apply = "monthdaynano", revert = "auto" }

[setup.statement.options]
// N.B. godror uses time.Duration for the non-batch mode; this is basically
// just a nanosecond timestamp, so large day values overflow. this is avoided
// in batch mode which can parse the fields individually.
"oracle.query.day_time_interval_type" = { apply = "monthdaynano", revert = "auto" }
"oracle.statement.execution_mode" = { apply = "batch", revert = "row" }

[tags]
field-type-name = "INTERVAL DAY TO SECOND"
sql-type-name = "INTERVAL DAY TO SECOND (oracle.query.day_time_interval_type = monthdaynano)"

// part: setup_query

