// part: metadata

hide = true

[setup]
drop = "TEST_SDO_GEOMETRY"

[setup.statement.options]
"oracle.use_extension_type" = { apply = "true", revert = "false" }

[tags]
sql-type-name = "SDO_GEOMETRY"

// part: setup_query

CREATE TABLE TEST_SDO_GEOMETRY (
    IDX INTEGER,
    RES1 SDO_GEOMETRY,
    RES2 SDO_GEOMETRY
);

INSERT INTO TEST_SDO_GEOMETRY (IDX, RES1, RES2) VALUES (1, NULL, NULL);
INSERT INTO TEST_SDO_GEOMETRY (IDX, RES1, RES2) VALUES (
    2,
    SDO_GEOMETRY('GEOMETRYCOLLECTION EMPTY', 4326),
    SDO_GEOMETRY('GEOMETRYCOLLECTION EMPTY', SDO_WEBMERCATOR)
);
INSERT INTO TEST_SDO_GEOMETRY (IDX, RES1, RES2) VALUES (
    3,
    SDO_GEOMETRY('POINT(1 2)', 4326),
    SDO_GEOMETRY('POINT(1 2)', SDO_WEBMERCATOR)
);

// part: query

SELECT RES1, RES2 FROM TEST_SDO_GEOMETRY ORDER BY IDX ASC

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES1",
            "format": "z",
            "flags": ["nullable"],
            "metadata": {
                "ARROW:extension:name": "geoarrow.wkb"
            }
        },
        {
            "name": "RES2",
            "format": "z",
            "flags": ["nullable"],
            "metadata": {
                "ARROW:extension:name": "geoarrow.wkb"
            }
        }
    ]
}

// part: expected

{"RES1": null, "RES2": null}
{"RES1": "AQcAACDmEAAAAAAAAA==", "RES2": "AQcAACARDwAAAAAAAA=="}
{"RES1": "AQEAACDmEAAAAAAAAAAA8D8AAAAAAAAAQA==", "RES2": "AQEAACARDwAAAAAAAAAA8D8AAAAAAAAAQA=="}
