[setup]
drop = "TEST_NUMBER_HIGHPRECISION"

[tags]
caveats = ["use_high_precision is true by default"]
sql-type-name = "NUMBER(p, s) (s != 0, p > 18, oracle.use_high_precision = true)"

// part: setup_query

CREATE TABLE test_number_highprecision (
    idx NUMBER(10, 0),
    res NUMBER(19, 0)
);

INSERT INTO test_number_highprecision (idx, res) VALUES (1, 12345);
INSERT INTO test_number_highprecision (idx, res) VALUES (2, -12345);
INSERT INTO test_number_highprecision (idx, res) VALUES (3, 9223372036854775807);
INSERT INTO test_number_highprecision (idx, res) VALUES (4, -9223372036854775808);
INSERT INTO test_number_highprecision (idx, res) VALUES (5, NULL);

// part: query

SELECT RES FROM TEST_NUMBER_HIGHPRECISION ORDER BY IDX ASC

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES",
            "format": "d:19,0",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"RES": 12345}
{"RES": -12345}
{"RES": 9223372036854775807}
{"RES": -9223372036854775808}
{"RES": null}
