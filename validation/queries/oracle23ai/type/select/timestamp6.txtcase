[setup]
drop = "TEST_TIMESTAMP6"

// part: setup_query

CREATE TABLE test_timestamp6 (
    idx INTEGER,
    "res" TIMESTAMP(6)
);

INSERT INTO test_timestamp6 (idx, "res") VALUES (1, TIMESTAMP '2023-05-15 13:45:30');
INSERT INTO test_timestamp6 (idx, "res") VALUES (2, TIMESTAMP '2000-01-01 00:00:00');
INSERT INTO test_timestamp6 (idx, "res") VALUES (3, TIMESTAMP '1969-07-20 20:17:40');
INSERT INTO test_timestamp6 (idx, "res") VALUES (4, TIMESTAMP '9999-12-31 23:59:59');
INSERT INTO test_timestamp6 (idx, "res") VALUES (5, NULL);
INSERT INTO test_timestamp6 (idx, "res") VALUES (6, TIMESTAMP '0001-01-01 00:00:00.000000');
INSERT INTO test_timestamp6 (idx, "res") VALUES (7, TIMESTAMP '2023-05-15 13:45:30.123456');

// part: query

SELECT "res" FROM TEST_TIMESTAMP6 ORDER BY IDX
