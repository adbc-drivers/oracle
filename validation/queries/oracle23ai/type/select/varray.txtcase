[setup]
drop = "TEST_VARRAY"

[setup.connection.options]
"oracle.use_extension_type" = { apply = "true", revert = "false" }

[setup.statement.options]
"oracle.use_extension_type" = { apply = "true", revert = "false" }

[tags]
caveats = ["The driver will return just the storage type by default; the extension type requires oracle.use_extension_type=true"]
sql-type-name = "VARRAY"

// part: setup_query

CREATE OR REPLACE TYPE STRING_ARRAY AS VARRAY(10) OF NVARCHAR2(1000);

CREATE TABLE test_varray (
    idx NUMBER(10, 0),
    res STRING_ARRAY
);

INSERT INTO test_varray (idx, res) VALUES (1, STRING_ARRAY('Hello', 'World', 'This', 'is', 'a', 'test'));
INSERT INTO test_varray (idx, res) VALUES (2, STRING_ARRAY(NULL, 'World'));
INSERT INTO test_varray (idx, res) VALUES (3, NULL);

// part: query

SELECT RES FROM TEST_VARRAY ORDER BY IDX ASC

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES",
            "format": "u",
            "flags": ["nullable"],
            "metadata": {
                "ARROW:extension:name": "arrow.json"
            }
        }
    ]
}

// part: expected

{"RES": "[\"Hello\",\"World\",\"This\",\"is\",\"a\",\"test\"]"}
{"RES": "[\"\",\"World\"]"}
{"RES": null}
