// part: metadata


ignore-lints = ["must-test-null-values"]
skip = "XMLType is not supported by rust-oracledb"

[setup]
drop = "TEST_XMLTYPE"

[setup.connection.options]
"oracle.use_extension_type" = { apply = "true", revert = "false" }

[setup.statement.options]
"oracle.use_extension_type" = { apply = "true", revert = "false" }

[tags]
caveats = ["The driver will return just the storage type by default; the extension type requires oracle.use_extension_type=true", "Oracle treats empty strings as NULL; rust-oracledb preserves NULL on read (the legacy driver normalizes it to an empty string)"]
sql-type-name = "XMLType"

// part: setup_query

CREATE TABLE test_xmltype (
    idx INTEGER,
    res XMLType
) XMLType res STORE AS BASICFILE BINARY XML;

INSERT INTO test_xmltype (idx, res) VALUES (1, '<root>test</root>');
INSERT INTO test_xmltype (idx, res) VALUES (2, '');
INSERT INTO test_xmltype (idx, res) VALUES (3, NULL);

// part: query

SELECT RES FROM TEST_XMLTYPE ORDER BY IDX ASC

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES",
            "format": "u",
            "flags": ["nullable"],
            "metadata": {
                "ARROW:extension:name": "arrow.opaque",
                "ARROW:extension:metadata": "{\"type_name\": \"XMLType\", \"vendor_name\": \"Oracle Database\"}"
            }
        }
    ]
}

// part: expected

{"RES": "<root>test</root>\n"}
{"RES": null}
{"RES": null}
