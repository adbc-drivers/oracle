INSERT INTO test_timestamptz3 (idx, "res") VALUES (4, TIMESTAMP '0001-01-01 00:00:00.000 +00:00');
INSERT INTO test_timestamptz3 (idx, "res") VALUES (5, TIMESTAMP '9999-12-31 23:59:59.999 +00:00');
