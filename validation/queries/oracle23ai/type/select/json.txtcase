[setup]
drop = "TEST_JSON"

[setup.connection.options]
"oracle.use_extension_type" = { apply = "true", revert = "false" }

[setup.statement.options]
"oracle.use_extension_type" = { apply = "true", revert = "false" }

[tags]
caveats = ["The driver will return just the storage type by default; the extension type requires oracle.use_extension_type=true"]
sql-type-name = "JSON"

// part: setup_query

CREATE TABLE test_json (
    idx NUMBER(10, 0),
    res JSON
) TABLESPACE tbsp;

INSERT INTO TEST_JSON (idx, res) VALUES (1, NULL);
INSERT INTO TEST_JSON (idx, res) VALUES (2, 'null');
INSERT INTO TEST_JSON (idx, res) VALUES (3, '"foobar"');
INSERT INTO TEST_JSON (idx, res) VALUES (4, '1.0');
INSERT INTO TEST_JSON (idx, res) VALUES (5, 'true');
INSERT INTO TEST_JSON (idx, res) VALUES (6, '[]');
INSERT INTO TEST_JSON (idx, res) VALUES (7, '["spam", "eggs", 2.5, false]');
INSERT INTO TEST_JSON (idx, res) VALUES (8, '{"a": 12345, "b": "hello", "c": [1, 2, 3], "d": {"e": "nested"}}');
INSERT INTO TEST_JSON (idx, res) VALUES (9, '[{"id": 1, "name": "Alice"}, {"id": 2, "name": "Bob"}]');

// part: query

SELECT RES FROM TEST_JSON ORDER BY IDX ASC

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES",
            "format": "u",
            "flags": ["nullable"],
            "metadata": {
                "ARROW:extension:name": "arrow.json"
            }
        }
    ]
}

// part: expected

{"RES": null}
{"RES": "null"}
{"RES": "\"foobar\""}
{"RES": "1"}
{"RES": "true"}
{"RES": "[]"}
{"RES": "[\"spam\",\"eggs\",2.5,false]"}
{"RES": "{\"a\":12345,\"b\":\"hello\",\"c\":[1,2,3],\"d\":{\"e\":\"nested\"}}"}
{"RES": "[{\"id\":1,\"name\":\"Alice\"},{\"id\":2,\"name\":\"Bob\"}]"}
