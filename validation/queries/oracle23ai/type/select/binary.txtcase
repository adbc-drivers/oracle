[setup]
drop = "TEST_BINARY"

[tags]
sql-type-name = "BLOB"
caveats = ["An empty string is treated as NULL on read"]

// part: setup_query

CREATE TABLE test_binary (
    idx INTEGER,
    res BLOB
);

INSERT INTO test_binary (idx, res) VALUES (1, HEXTORAW('e38193e38293e381abe381a1e381afe38081e4b896e7958cefbc81'));
INSERT INTO test_binary (idx, res) VALUES (2, HEXTORAW('00'));
INSERT INTO test_binary (idx, res) VALUES (3, HEXTORAW('deadbeef'));
INSERT INTO test_binary (idx, res) VALUES (4, HEXTORAW(''));
INSERT INTO test_binary (idx, res) VALUES (5, NULL);

// part: query

SELECT RES FROM TEST_BINARY ORDER BY IDX

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES",
            "format": "Z",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"RES": "44GT44KT44Gr44Gh44Gv44CB5LiW55WM77yB"}
{"RES": "AA=="}
{"RES": "3q2+7w=="}
{"RES": null}
{"RES": null}
