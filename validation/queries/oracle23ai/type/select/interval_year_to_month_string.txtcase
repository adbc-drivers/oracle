{"RES0": "P11M", "RES1": "P9Y11M", "RES2": "P99Y11M", "RES3": "P999Y11M", "RES4": "P9999Y11M", "RES5": "P99999Y11M", "RES6": "P999999Y11M", "RES7": "P9999999Y11M", "RES8": "P99999999Y11M", "RES9": "P178956970Y7M"}
{"RES0": "P-11M", "RES1": "P-9Y-11M", "RES2": "P-99Y-11M", "RES3": "P-999Y-11M", "RES4": "P-9999Y-11M", "RES5": "P-99999Y-11M", "RES6": "P-999999Y-11M", "RES7": "P-9999999Y-11M", "RES8": "P-99999999Y-11M", "RES9": "P-178956970Y-8M"}
