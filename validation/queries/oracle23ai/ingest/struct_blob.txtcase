// part: metadata

[setup.statement.options]
"oracle.ingest.struct_type" = { apply = "BLOB", revert = "" }

[tags]
sql-type-name = "BLOB"

// part: input_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "l",
            "flags": ["nullable"]
        },
        {
            "name": "value",
            "format": "+s",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "key",
                    "format": "U",
                    "flags": ["nullable"]
                },
                {
                    "name": "num",
                    "format": "g",
                    "flags": ["nullable"]
                },
                {
                    "name": "row",
                    "format": "g",
                    "flags": ["nullable"]
                },
                {
                    "name": "active",
                    "format": "b",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: input

{"idx": 0, "value": null}
{"idx": 1, "value": {}}
{"idx": 2, "value": {"key": "foo"}}
{"idx": 3, "value": {"key": "foo", "num": 42.42, "row": 64, "active": false}}

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "d:19,0",
            "flags": ["nullable"]
        },
        {
            "name": "value",
            "format": "Z",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"idx": 0, "value": null}
{"idx": 1, "value": "e30="}
{"idx": 2, "value": "eyJrZXkiOiJmb28ifQ=="}
{"idx": 3, "value": "eyJhY3RpdmUiOmZhbHNlLCJrZXkiOiJmb28iLCJudW0iOjQyLjQyLCJyb3ciOjY0fQ=="}
