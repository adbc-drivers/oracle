// part: metadata

[setup.statement.options]
"oracle.ingest.string_type" = { apply = "nvarchar2", revert = "nvarchar2" }
"oracle.ingest.nvarchar2_size" = { apply = "2000", revert = "2000" }

[tags]
sql-type-name = "NVARCHAR2"

// part: input_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "l",
            "flags": ["nullable"]
        },
        {
            "name": "value",
            "format": "u",
            "flags": ["nullable"]
        }
    ]
}

// part: input

{"idx": -1, "value": null}
{"idx":0,"value":""}
{"idx":1,"value":""}
{"idx":2,"value":""}

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "d:19,0",
            "flags": ["nullable"]
        },
        {
            "name": "value",
            "format": "u",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"idx": -1, "value": null}
{"idx":0,"value":""}
{"idx":1,"value":""}
{"idx":2,"value":""}
