// part: metadata

[setup.statement.options]
"oracle.statement.execution_mode" = { apply = "batch", revert = "row" }
"oracle.use_extension_type" = { apply = "true", revert = "false" }

[tags]
caveats = ["Oracle treats certain empty geometries as NULL"]
sql-type-name = "SDO_GEOMETRY"

// part: input_schema
{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "d:19,0",
            "flags": ["nullable"]
        },
        {
            "name": "value",
            "format": "u",
            "flags": ["nullable"],
            "metadata": {
                "ARROW:extension:name": "geoarrow.wkt",
                "ARROW:extension:metadata": "{\"crs\": \"EPSG:3857\", \"crs_type\": \"authority_code\"}"
            }
        }
    ]
}

// part: input
{"idx": 0, "value": null}
{"idx": 1, "value": "GEOMETRYCOLLECTION EMPTY"}
{"idx": 2, "value": "POINT (1 2)"}
{"idx": 3, "value": "LINESTRING (1 2, 3 4)"}
{"idx": 4, "value": "POLYGON ((1 2, 3 4, 5 6, 1 2))"}
{"idx": 5, "value": "MULTIPOINT ((1 2), (3 4))"}
{"idx": 6, "value": "MULTILINESTRING ((1 2, 3 4), (5 6, 7 8))"}
{"idx": 7, "value": "MULTIPOLYGON (((1 2, 3 4, 5 6, 1 2)), ((7 8, 9 10, 11 12, 7 8)))"}
{"idx": 8, "value": "GEOMETRYCOLLECTION (POINT (1 2), LINESTRING (3 4, 5 6))"}

// part: expected_schema
{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "d:19,0",
            "flags": ["nullable"]
        },
        {
            "name": "value",
            "format": "z",
            "flags": ["nullable"],
            "metadata": {
                "ARROW:extension:name": "geoarrow.wkb",
                "ARROW:extension:metadata": "{\"crs\": \"EPSG:3857\", \"crs_type\": \"authority_code\"}"
            }
        }
    ]
}

